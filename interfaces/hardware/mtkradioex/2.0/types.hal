enum MtkApnTypes : android.hardware.radio@1.5::ApnTypes {
    RCS = 1 << 12,
    BIP = 1 << 13,
    VSIM = 1 << 14,
    MTKALL = ALL | MCX | XCAP | RCS | BIP | VSIM,
};

