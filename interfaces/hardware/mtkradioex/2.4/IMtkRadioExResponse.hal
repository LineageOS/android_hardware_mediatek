    oneway setBandPriorityListResponse(android.hardware.radio@1.0::RadioResponseInfo info);

    oneway set4x4MimoEnabledResponse(android.hardware.radio@1.0::RadioResponseInfo info);

    oneway get4x4MimoEnabledResponse(android.hardware.radio@1.0::RadioResponseInfo info,
