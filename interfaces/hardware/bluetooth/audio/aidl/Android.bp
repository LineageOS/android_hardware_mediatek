aidl_interface {
    name: "vendor.mediatek.hardware.bluetooth.audio",
    vendor_available: true,
    srcs: ["vendor/mediatek/hardware/bluetooth/audio/*.aidl"],
    stability: "vintf",
    owner: "mediatek",
    defaults: [
        "latest_android_hardware_audio_common_import_interface",
    ],
    imports: [
        "android.hardware.common-V2",
        "android.hardware.common.fmq-V1",
    ],
    backend: {
        cpp: {
            enabled: false,
        },
        java: {
            sdk_version: "module_current",
            enabled: false,
        },
        ndk: {
            enabled: true,
            min_sdk_version: "31",
        },
    },
    versions_with_info: [
        {
            version: "1",
            imports: [
                "android.hardware.common-V2",
                "android.hardware.common.fmq-V1",
                "android.hardware.audio.common-V1",
            ],
        },
        {
            version: "2",
            imports: [
                "android.hardware.common-V2",
                "android.hardware.common.fmq-V1",
                "android.hardware.audio.common-V2",
            ],
        },
    ],
    frozen: false,
}

// Note: This should always be one version ahead of the last frozen version
cc_defaults {
    name: "latest_vendor_mediatek_hardware_bluetooth_audio_ndk_shared",
    shared_libs: [
        "vendor.mediatek.hardware.bluetooth.audio-V3-ndk",
    ],
}
