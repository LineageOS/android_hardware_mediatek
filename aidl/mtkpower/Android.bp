cc_binary {
    name: "vendor.mediatek.hardware.mtkpower-service.stub",
    defaults: ["android.hardware.power-ndk_shared"],
    relative_install_path: "hw",
    init_rc: ["vendor.mediatek.hardware.mtkpower-service.stub.rc"],
    vendor: true,
    srcs: [
        "MtkPowerService.cpp",
        "service.cpp",
    ],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "vendor.mediatek.hardware.mtkpower-V1-ndk",
    ],
}
