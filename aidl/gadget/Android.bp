soong_config_module_type {
    name: "target_board_platform_prebuilt_etc",
    module_type: "prebuilt_etc",
    config_namespace: "ANDROID",
    value_variables: ["target_board_platform"],
    properties: [
        "name",
    ],
}

cc_binary {
    name: "android.hardware.usb.gadget-service.mediatek",
    relative_install_path: "hw",
    init_rc: ["android.hardware.usb.gadget-service.rc"],
    vintf_fragments: [
        "android.hardware.usb.gadget-service.xml",
    ],
    vendor: true,
    srcs: [
        "service_gadget.cpp",
        "UsbGadget.cpp",
    ],
    cflags: [
        "-Wall",
        "-Werror",
    ],
    shared_libs: [
        "libbase",
        "liblog",
        "libutils",
        "android.frameworks.stats-V2-ndk",
        "android.hardware.usb.gadget-V1-ndk",
        "libcutils",
        "libbinder_ndk",
    ],
    static_libs: [
        "libpixelusb-aidl",
    ],
    proprietary: true,
    export_shared_lib_headers: [
        "android.frameworks.stats-V2-ndk",
    ],
}

target_board_platform_prebuilt_etc {
    soong_config_variables: {
        target_board_platform: {
            name: "init.%s.usb.rc",
            conditions_default: {
                name: "init.mediatek.usb.rc",
            },
        },
    },
    src: "init.mediatek.usb.rc",
    sub_dir: "init/hw",
    vendor: true,
}
