cc_library_shared {
    name: "android.hardware.bluetooth.audio-impl-mediatek-aidl",
    vendor: true,
    defaults: [
        "latest_android_hardware_bluetooth_audio_ndk_shared",
        "latest_vendor_mediatek_hardware_bluetooth_audio_ndk_shared",
    ],
    cpp_std: "gnu++23",
    srcs: [
        "AidlToAidlMiddleware.cpp",
        "MTKBluetoothAudioProvider.cpp",
        "MTKBluetoothAudioProviderFactory.cpp",
        "service.cpp",
    ],
    export_include_dirs: ["."],
    header_libs: ["libhardware_headers"],
    shared_libs: [
        "libbase",
        "libutils",
        "libbinder_ndk",
        "liblog",
        "android.hardware.bluetooth.audio-impl",
    ],
}
