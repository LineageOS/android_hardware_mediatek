soong_namespace {
    imports: ["hardware/mediatek"],
}

cc_defaults {
    name: "libmtkperf_client_defaults",
    srcs: ["mtkperf_client.c"],
    shared_libs: ["liblog"],
}

cc_defaults {
    name: "libpowerhalwrap_defaults",
    srcs: ["powerhalwrap_vendor.c"],
    shared_libs: ["liblog"],
}

cc_library_shared {
    name: "libmtkperf_client_vendor",
    defaults: ["libmtkperf_client_defaults"],
    vendor: true,
}

cc_library_shared {
    name: "libmtkperf_client",
    defaults: ["libmtkperf_client_defaults"],
}

cc_library_shared {
    name: "libpowerhalwrap",
    defaults: ["libpowerhalwrap_defaults"],
}

cc_library_shared {
    name: "libpowerhalwrap_vendor",
    defaults: ["libpowerhalwrap_defaults"],
    vendor: true,
    srcs: select(soong_config_variable("libmtkperf_client", "powerhalwrap_aidl"), {
        true: ["powerhalwrap_vendor_aidl.cpp"],
        default: [],
    }),
    shared_libs: select(soong_config_variable("libmtkperf_client", "powerhalwrap_aidl"), {
        true: ["libbinder_ndk"],
        default: [],
    }),
    static_libs: select(soong_config_variable("libmtkperf_client", "powerhalwrap_aidl"), {
        true: ["vendor.mediatek.hardware.mtkpower-V1-ndk"],
        default: [],
    }),
}

cc_library_shared {
    name: "libperfctl_vendor",
    vendor: true,
    srcs: ["perfctl_vendor.c"],
    shared_libs: ["liblog"],
}
